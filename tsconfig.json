{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "src/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "vite.config.ts",
    "web.ts"
  ]
}
