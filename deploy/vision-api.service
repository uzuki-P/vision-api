[Unit]
Description=Vision API using OpenCode and Codex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/_sandbox/vision-api
EnvironmentFile=%h/projects/_sandbox/vision-api/.env
Environment=PATH=%h/.opencode/bin:%h/.local/bin:%h/.vite-plus/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.vite-plus/bin/bun run start
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
