# Keep the service on loopback. The named Tailscale route forwards to this port.
HOST=127.0.0.1
PORT=3000
# Port for the Solid test UI. It also binds to loopback.
WEB_PORT=27182

# Select the default CLI backend. Requests can override provider/model/effort.
DEFAULT_PROVIDER=opencode
DEFAULT_MODEL=
DEFAULT_REASONING_EFFORT=
# Optional CLI executable names or absolute paths.
OPENCODE_BIN=opencode
CODEX_BIN=codex

# Optional comma-separated model allowlist, such as openai/gpt-4.1-mini.
ALLOWED_MODELS=

# Optional comma-separated exact origins allowed to call the API from a browser
# (CORS), such as https://vision-api-preview.ts.uzuki-p.my.id. Empty disables CORS.
CORS_ORIGINS=

REQUEST_TIMEOUT_MS=120000
# Maximum CLI runtime for POST /v1/jobs (default 30 minutes).
JOB_TIMEOUT_MS=1800000
# Keep completed job results for 24 hours. Jobs that exceed this age expire after completion.
JOB_RETENTION_MS=86400000
# Pending jobs beyond the concurrent running limit.
MAX_QUEUED_JOBS=16
# Optional: defaults to ~/.local/state/vision-api/jobs.
# JOB_DATA_DIR=/absolute/path/to/private/job-data
MAX_IMAGE_BYTES=12582912
MAX_CONCURRENT_REQUESTS=2
MAX_REQUESTS_PER_MINUTE=30

# Generate a long random value. The live .env file is created with mode 0600.
API_TOKEN=replace-with-a-random-secret
