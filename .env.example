# Keep the service on loopback. The named Tailscale route forwards to this port.
HOST=127.0.0.1
PORT=3000

# Select the default CLI backend. Requests can override provider/model/effort.
DEFAULT_PROVIDER=opencode
DEFAULT_MODEL=
DEFAULT_REASONING_EFFORT=

# Optional comma-separated model allowlist, such as openai/gpt-4.1-mini.
ALLOWED_MODELS=

REQUEST_TIMEOUT_MS=120000
MAX_IMAGE_BYTES=12582912
MAX_CONCURRENT_REQUESTS=2
MAX_REQUESTS_PER_MINUTE=30

# Generate a long random value. The live .env file is created with mode 0600.
API_TOKEN=replace-with-a-random-secret
